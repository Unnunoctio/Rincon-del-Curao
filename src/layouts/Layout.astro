---
// Supports weights 100-900
import '@/styles/global.css';
import '@fontsource-variable/geist';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content="Recopilador de precios de distintas bebidas alcohólicas, vendidas en Chile" />
	</head>
	<body class="flex xl:flex-row flex-col bg-c-onix-black font-geist text-c-snow-white">
		<slot />
	</body>
</html>
