---
import '@fontsource/geist-sans';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content="Recopilador de precios de distintas bebidas alcohólicas, vendidas en Chile" />

		<meta name="og:title" content={title} />
		<meta name="og:description" content="Recopilador de precios de distintas bebidas alcohólicas, vendidas en Chile" />
		<meta name="og:url" content="https://rincondelcurao.com" />
		<meta name="og:site_name" content="Rincón del Curao" />
		<meta name="og:locale" content="es_ES" />
		<meta name="og:image" content="https://assets.rincondelcurao.com/image-og.png" />
		<meta name="og:type" content="website" />
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content="Recopilador de precios de distintas bebidas alcohólicas, vendidas en Chile" />
		<meta name="twitter:image" content="https://assets.rincondelcurao.com/image-og.png" />
	</head>
	<body class="font-geist"> 
		<slot />
	</body>
</html>
