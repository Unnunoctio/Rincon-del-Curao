---
import { Navigation } from "@/components/client/Navigation";
import Logo from "@/components/Logo.astro";
import Search from "@/components/Search.astro";
import WebInfoContent from "./WebInfoContent.astro";
import { SidebarClient } from "@/components/client/SidebarClient";

const { category } = Astro.params;
const subCategories = Astro.url.searchParams.getAll("sub_category");

let routeModule = undefined
if (category !== undefined) {
  routeModule = {
    route: category,
    category: subCategories.length === 1 ? subCategories[0] : undefined
  }
}
---

<section class="hidden xl:block">
  <aside class="top-0 left-0 sticky flex flex-col gap-10 py-6 pr-3 pl-6 w-[280px]">
    <a href="/" class="group w-fit" aria-label="Ir al inicio">
      <Logo className="w-[147px] h-[44px] group-hover:scale-105 transition-[scale] duration-300" />
    </a>
    <Search />
    <section class="flex flex-col gap-3">
      <Navigation client:load routeModule={routeModule} />
      <hr class="border-c-steel-gray" />
      <WebInfoContent />
    </section>
  </aside>
</section>

<SidebarClient client:load routeModule={routeModule} />
