---
import ArrowUpIcon from "../icons/ArrowUpIcon.astro";
---

<button
  id="scroll-top"
  class="group top-0 right-0 sm:static absolute hover:bg-c-lead-gray p-2 rounded-full w-fit h-fit cursor-pointer"
  aria-label="Ir al inicio"
>
  <ArrowUpIcon className="stroke-c-steel-gray group-hover:stroke-c-snow-white" />
</button>

<script>
  const scrollTop = document.getElementById("scroll-top") as HTMLButtonElement;

  scrollTop.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>